    {
      "id": 11,
      "type": "gauge",
      "title": "Taux d'abstention / de rejet automatique (%)",
      "description": "Part des prédictions nécessitant une revue humaine sur les 15 dernières minutes. Rouge sous 5 % ou à partir de 35 %; vert de 5 % à 30 %; orange de 30 % à 35 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(sum(increase(backend_abstentions_total[15m])) / clamp_min(sum(increase(backend_predictions_total[15m])), 1), 1)",
          "instant": true,
          "legendFormat": "Taux abstention",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Non instrumenté",
