      "type": "stat",
      "title": "Modèle - Gate d'évaluation (dernier run local)",
      "description": "Verdict réel de scripts/evaluate_model.py : PASS si les quatre métriques respectent leurs planchers et leur baisse maximale face au golden run; sinon FAIL.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(cisia_evaluation_gate_status)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune évaluation publiée",
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
