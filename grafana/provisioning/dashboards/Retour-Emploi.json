          "max": 1,
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.05 },
              { "color": "orange", "value": 0.30 },
              { "color": "red", "value": 0.35 }
            ]
          }
        },
        "overrides": []
